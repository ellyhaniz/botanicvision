<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_error_banner">
            <ImageView android:id="@+id/errIcon" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_no_unlock" android:contentDescription="Error" />
        </FrameLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/errTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Failed card unlock" android:textColor="@color/plantdex_text_primary" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/errTimestamp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="07 Dec 2026, 18:14:05" android:textColor="@color/plantdex_text_muted" android:textSize="12sp" />
        </LinearLayout>

        <TextView android:id="@+id/errRef" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_unselected" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"
            android:text="#ERR198" android:textColor="@color/plantdex_text_muted" android:textSize="11sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="@color/plantdex_divider" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Collectible" android:textColor="@color/plantdex_text_muted" android:textSize="12sp" />
        <TextView android:id="@+id/errCollectible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="#0087 Tembusu Tree" android:textColor="@color/plantdex_text_primary" android:textStyle="bold" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="User" android:textColor="@color/plantdex_text_muted" android:textSize="12sp" />
        <TextView android:id="@+id/errUser" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="jtan_042" android:textColor="@color/plantdex_text_primary" android:textStyle="bold" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Status" android:textColor="@color/plantdex_text_muted" android:textSize="12sp" />
        <TextView android:id="@+id/errStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_error_banner" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="Unresolved" android:textColor="@color/plantdex_error_text" android:textSize="11sp" android:layout_marginEnd="6dp" />
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_chevron_right" android:contentDescription="Open" />
    </LinearLayout>
</LinearLayout>
