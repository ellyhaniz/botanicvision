<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="520dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_tile"
                android:src="@drawable/ic_eco"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:contentDescription="@string/flora" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInfoCommonName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tembusu Tree"
                    android:textColor="@color/plantdex_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInfoScientificName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cyrtophyllum fragrans"
                    android:textColor="@color/plantdex_text_muted"
                    android:textSize="13sp"
                    android:textStyle="italic" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/plantdex_divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Family"
            android:textColor="@color/plantdex_label"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvInfoFamily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Gentianaceae"
            android:textColor="@color/plantdex_text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Identification Features"
            android:textColor="@color/plantdex_label"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvInfoFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Dark fissured bark, small cream flowers, spreading crown."
            android:textColor="@color/plantdex_text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Fun Fact"
            android:textColor="@color/plantdex_label"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvInfoFunFact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Appears on the reverse of the Singapore five-dollar note."
            android:textColor="@color/plantdex_text_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCloseInfo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_cancel_pill"
            android:stateListAnimator="@null"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="@color/plantdex_cancel_text"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
