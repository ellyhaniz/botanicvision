<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/plantdex_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <include layout="@layout/header_role" android:id="@+id/header" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Create Botanical Record"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Common Name" android:textColor="@color/plantdex_label" android:textStyle="bold" android:textSize="13sp" />
                    <EditText android:id="@+id/etCommonName" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_box" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Tembusu" android:textColor="@color/plantdex_text_primary" android:textSize="14sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Scientific Name" android:textColor="@color/plantdex_label" android:textStyle="bold" android:textSize="13sp" />
                    <EditText android:id="@+id/etScientificName" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_box" android:paddingStart="14dp" android:paddingEnd="14dp" android:inputType="textPersonName"
                        android:text="Cyrtophyllum fragrans" android:textColor="@color/plantdex_text_primary" android:textStyle="italic" android:textSize="14sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Family" android:textColor="@color/plantdex_label" android:textStyle="bold" android:textSize="13sp" />
                    <EditText android:id="@+id/etFamily" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_box" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Gentianaceae" android:textColor="@color/plantdex_text_primary" android:textSize="14sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Image" android:textColor="@color/plantdex_label" android:textStyle="bold" android:textSize="13sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="6dp" android:background="@drawable/bg_dashed_box" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_image_upload" android:contentDescription="Upload" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Upload plant image" android:textColor="@color/plantdex_text_muted" android:textSize="12sp" />
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Identification Features" android:textColor="@color/plantdex_label" android:textStyle="bold" android:textSize="13sp" />
                    <EditText android:id="@+id/etFeatures" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_box" android:padding="12dp" android:gravity="top" android:inputType="textMultiLine"
                        android:text="Dark fissured bark, small cream flowers, spreading crown." android:textColor="@color/plantdex_text_primary" android:textSize="13sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Fun Fact" android:textColor="@color/plantdex_label" android:textStyle="bold" android:textSize="13sp" />
                    <EditText android:id="@+id/etFunFact" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_box" android:padding="12dp" android:gravity="top" android:inputType="textMultiLine"
                        android:text="Appears on the reverse of the Singapore five-dollar note." android:textColor="@color/plantdex_text_primary" android:textSize="13sp" />

                    <LinearLayout android:id="@+id/layoutDuplicateWarning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                        android:background="@drawable/bg_note" android:padding="12dp" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚠ A record with this scientific name already exists. Continue anyway?" android:textColor="@color/plantdex_note_text" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
                        <Button android:id="@+id/btnSaveRecord" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
                            android:background="@drawable/btn_primary" android:backgroundTint="@color/plantdex_bg" android:text="Save" android:textAllCaps="false" android:textColor="@color/white" android:textStyle="bold" android:stateListAnimator="@null" />
                        <Button android:id="@+id/btnCancelRecord" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="10dp"
                            android:background="@drawable/btn_cancel_pill" android:text="Cancel" android:textAllCaps="false" android:textColor="@color/plantdex_cancel_text" android:textStyle="bold" android:stateListAnimator="@null" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/navContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
