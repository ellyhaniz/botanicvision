<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plantdex_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:src="@drawable/logo_plantdex"
            android:contentDescription="@string/app_title" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_title"
            android:textColor="@color/white"
            android:textSize="42sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <!-- Account type -->
        <Spinner
            android:id="@+id/spinnerAccountType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_input_underline"
            android:paddingStart="4dp"
            android:paddingBottom="10dp" />

        <!-- Username -->
        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_input_underline"
            android:drawableStart="@drawable/ic_person"
            android:drawableTint="@color/white"
            android:drawablePadding="12dp"
            android:hint="@string/enter_username"
            android:textColorHint="@color/plantdex_hint"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:inputType="text"
            android:maxLines="1"
            android:paddingBottom="10dp" />

        <!-- Password -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_input_underline"
            android:drawableStart="@drawable/ic_lock"
            android:drawableTint="@color/white"
            android:drawablePadding="12dp"
            android:hint="@string/enter_password"
            android:textColorHint="@color/plantdex_hint"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:padding="4dp"
            android:text="@string/forgot_password"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSignIn"
            android:layout_width="180dp"
            android:layout_height="52dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/btn_primary"
            android:text="@string/sign_in"
            android:textColor="@color/plantdex_button_text"
            android:textSize="16sp"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/no_account"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="@drawable/btn_secondary"
            android:text="@string/register"
            android:textColor="@color/plantdex_secondary_text"
            android:textSize="13sp"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>