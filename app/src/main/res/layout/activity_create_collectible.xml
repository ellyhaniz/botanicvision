<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/plantdex_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <include layout="@layout/header_role" android:id="@+id/header" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Create New Collectible"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Linked identification record" android:textColor="@color/plantdex_label" android:textStyle="bold" android:textSize="13sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_box" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:text="#0231 Tembusu Tree · Plant" android:textColor="@color/plantdex_text_primary" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="✓ Verified · only unlinked verified records are listed" android:textColor="@color/plantdex_success_text" android:textSize="12sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Collectible name" android:textColor="@color/plantdex_label" android:textStyle="bold" android:textSize="13sp" />
                    <EditText android:id="@+id/etCollectibleName" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_box" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Tembusu Tree" android:textColor="@color/plantdex_text_primary" android:textSize="14sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Description" android:textColor="@color/plantdex_label" android:textStyle="bold" android:textSize="13sp" />
                    <EditText android:id="@+id/etCollectibleDesc" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_box" android:padding="14dp" android:gravity="top" android:inputType="textMultiLine"
                        android:text="A heritage tree native to Southeast Asia, recognisable by its dark fissured bark." android:textColor="@color/plantdex_text_primary" android:textSize="13sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Image" android:textColor="@color/plantdex_label" android:textStyle="bold" android:textSize="13sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="6dp" android:background="@drawable/bg_dashed_box" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_image_upload" android:contentDescription="Upload" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Upload collectible image" android:textColor="@color/plantdex_text_muted" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Category" android:textColor="@color/plantdex_label" android:textStyle="bold" android:textSize="13sp" />
                            <TextView android:id="@+id/tvCategoryValue" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp"
                                android:background="@drawable/bg_input_box" android:gravity="center_vertical" android:paddingStart="12dp" android:text="Flora" android:textColor="@color/plantdex_text_primary" android:textSize="13sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rarity level" android:textColor="@color/plantdex_label" android:textStyle="bold" android:textSize="13sp" />
                            <TextView android:id="@+id/tvRarityValue" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp"
                                android:background="@drawable/bg_input_box" android:gravity="center_vertical" android:paddingStart="12dp" android:text="Select" android:textColor="@color/plantdex_text_muted" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/layoutRarityError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                        android:background="@drawable/bg_error_banner" android:padding="12dp" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚠ Select a rarity level" android:textColor="@color/plantdex_error_text" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
                        <Button android:id="@+id/btnSaveCollectible" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
                            android:background="@drawable/btn_primary" android:backgroundTint="@color/plantdex_bg" android:text="Save" android:textAllCaps="false" android:textColor="@color/white" android:textStyle="bold" android:stateListAnimator="@null" />
                        <Button android:id="@+id/btnCancelCollectible" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="10dp"
                            android:background="@drawable/btn_cancel_pill" android:text="Cancel" android:textAllCaps="false" android:textColor="@color/plantdex_cancel_text" android:textStyle="bold" android:stateListAnimator="@null" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/navContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
