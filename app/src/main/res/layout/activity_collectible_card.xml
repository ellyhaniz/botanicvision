<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/plantdex_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <include layout="@layout/header_role" android:id="@+id/header" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Collectible Card"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Locked notice -->
            <LinearLayout
                android:id="@+id/layoutLockedNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ⓘ Discover this item in the gardens to reveal its details."
                    android:textColor="@color/plantdex_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/framePhoto"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="@drawable/bg_photo_placeholder">

                        <ImageView
                            android:id="@+id/ivPhotoIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_leaf"
                            app:tint="#BFE3CF"
                            android:contentDescription="Collectible photo" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCardName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tembusu Tree"
                                android:textColor="@color/plantdex_text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCardSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Collectible #0087"
                                android:textColor="@color/plantdex_text_muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCardStatusPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_rare"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="Rare"
                            android:textColor="@color/plantdex_rare_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/plantdex_divider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Category" android:textColor="@color/plantdex_text_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tvCardCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Flora" android:textColor="@color/plantdex_text_primary" android:textStyle="bold" android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/rowLinkedRecord" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Linked record" android:textColor="@color/plantdex_text_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tvCardLinkedRecord" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="#0231 Tembusu Tree" android:textColor="@color/plantdex_text_primary" android:textStyle="bold" android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/rowRarity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:visibility="gone">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Rarity level" android:textColor="@color/plantdex_text_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tvCardRarityValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hidden" android:textColor="@color/plantdex_text_primary" android:textStyle="bold" android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/rowScientific" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Scientific name" android:textColor="@color/plantdex_text_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tvCardScientific" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cyrtophyllum fragrans" android:textColor="@color/plantdex_text_primary" android:textStyle="bold" android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/rowUnlocked" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Unlocked" android:textColor="@color/plantdex_text_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tvCardUnlocked" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="07 Dec 2026, 18:14:05" android:textColor="@color/plantdex_text_primary" android:textStyle="bold" android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/rowStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:visibility="gone">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Status" android:textColor="@color/plantdex_text_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tvCardStatusValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"
                            android:text="Discovered" android:textColor="@color/plantdex_success_text" android:textSize="11sp" />
                    </LinearLayout>

                    <View android:id="@+id/dividerDescription" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/plantdex_divider" />

                    <TextView
                        android:id="@+id/tvCardDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="A heritage tree native to Southeast Asia, recognisable by its dark fissured bark."
                        android:textColor="@color/plantdex_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Discovered actions -->
            <LinearLayout
                android:id="@+id/groupDiscoveredActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMoreInfo"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_cancel_pill"
                    android:text="🔍 More info"
                    android:textAllCaps="false"
                    android:textColor="@color/plantdex_cancel_text"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnShare"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:text="⇗ Share"
                    android:textAllCaps="false"
                    android:textColor="@color/plantdex_secondary_text"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- Undiscovered action -->
            <Button
                android:id="@+id/btnStartIdentifying"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_secondary"
                android:text="📷 Start identifying"
                android:textAllCaps="false"
                android:textColor="@color/plantdex_secondary_text"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/navContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
