<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/plantdex_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/researcher_id" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/plantdex_management" android:textColor="@color/plantdex_hint" android:textSize="12sp"/>
        </LinearLayout>
        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_tile"
            android:src="@drawable/ic_person"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="@string/researcher_id"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="Create Collectible"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_panel_top">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Record Type" android:textColor="@color/plantdex_label" android:textSize="13sp" android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="18dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/toggleBotanical"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/btn_primary"
                        android:text="Botanical"
                        android:textColor="@color/plantdex_button_text"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null"/>
                    <Button
                        android:id="@+id/toggleArchitectural"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_toggle_inactive"
                        android:text="Architectural"
                        android:textColor="@color/plantdex_secondary_text"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/groupBotanical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Common Name" android:textColor="@color/plantdex_label" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/etCommonName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:hint="Tembusu"
                        android:inputType="text"
                        android:textColor="@color/plantdex_text_primary"
                        android:textSize="14sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scientific Name" android:textColor="@color/plantdex_label" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/etScientificName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:hint="Cyrtophyllum fragrans"
                        android:inputType="text"
                        android:textColor="@color/plantdex_text_primary"
                        android:textSize="14sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Family" android:textColor="@color/plantdex_label" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/etFamily"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:hint="Gentianaceae"
                        android:inputType="text"
                        android:textColor="@color/plantdex_text_primary"
                        android:textSize="14sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Identification Features" android:textColor="@color/plantdex_label" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/etFeatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="2"
                        android:gravity="top|start"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp"
                        android:hint="Dark fissured bark, small cream flowers, spreading crown."
                        android:inputType="textMultiLine"
                        android:textColor="@color/plantdex_text_primary"
                        android:textSize="14sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fun Fact" android:textColor="@color/plantdex_label" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/etFunFact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="2"
                        android:gravity="top|start"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp"
                        android:hint="Appears on the reverse of the Singapore five-dollar note."
                        android:inputType="textMultiLine"
                        android:textColor="@color/plantdex_text_primary"
                        android:textSize="14sp"/>

                    <LinearLayout
                        android:id="@+id/warningBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_warning_banner"
                        android:padding="12dp"
                        android:layout_marginBottom="14dp"
                        android:visibility="gone">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_warning" android:contentDescription="@null"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="A record with this scientific name already exists. Continue anyway?"
                            android:textColor="@color/plantdex_warn_icon"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/groupArchitecture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Structure Name" android:textColor="@color/plantdex_label" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/etStructureName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:hint="Bandstand"
                        android:inputType="text"
                        android:textColor="@color/plantdex_text_primary"
                        android:textSize="14sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Location" android:textColor="@color/plantdex_label" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/etLocation"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:hint="Bandstand Hill, Tanglin Core"
                        android:inputType="text"
                        android:textColor="@color/plantdex_text_primary"
                        android:textSize="14sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Style" android:textColor="@color/plantdex_label" android:textSize="13sp" android:textStyle="bold"/>
                            <EditText
                                android:id="@+id/etStyle"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginBottom="14dp"
                                android:background="@drawable/bg_input_field"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:hint="Victorian"
                                android:inputType="text"
                                android:textColor="@color/plantdex_text_primary"
                                android:textSize="14sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Constructed" android:textColor="@color/plantdex_label" android:textSize="13sp" android:textStyle="bold"/>
                            <EditText
                                android:id="@+id/etConstructed"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginBottom="14dp"
                                android:background="@drawable/bg_input_field"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:drawableEnd="@drawable/ic_calendar"
                                android:hint="1930"
                                android:inputType="number"
                                android:textColor="@color/plantdex_text_primary"
                                android:textSize="14sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Description" android:textColor="@color/plantdex_label" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/etDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="2"
                        android:gravity="top|start"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp"
                        android:hint="An octagonal cast iron bandstand set on a low rise, originally used for evening band performances."
                        android:inputType="textMultiLine"
                        android:textColor="@color/plantdex_text_primary"
                        android:textSize="14sp"/>

                    <LinearLayout
                        android:id="@+id/errorBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_error_banner"
                        android:padding="12dp"
                        android:layout_marginBottom="14dp"
                        android:visibility="gone">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_warning" android:contentDescription="@null"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Enter a location"
                            android:textColor="@color/plantdex_error_text"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Image" android:textColor="@color/plantdex_label" android:textSize="13sp" android:textStyle="bold"/>
                <LinearLayout
                    android:id="@+id/btnUploadImage"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_input_field"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_camera" android:contentDescription="@null"/>
                    <TextView
                        android:id="@+id/tvUploadLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Upload plant image"
                        android:textColor="@color/plantdex_text_muted"
                        android:textSize="13sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnSave"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/btn_primary"
                        android:text="@string/save"
                        android:textColor="@color/plantdex_button_text"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null"/>
                    <Button
                        android:id="@+id/btnCancel"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/btn_cancel_pill"
                        android:text="@string/cancel"
                        android:textColor="@color/plantdex_cancel_text"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/navContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>
