<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/plantdex_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <include layout="@layout/header_role" android:id="@+id/header" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Edit Profile Type"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_avatar_circle">
                            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_person" android:contentDescription="Type" />
                        </FrameLayout>
                        <TextView android:id="@+id/tvTypeTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                            android:text="Researcher" android:textColor="@color/plantdex_text_primary" android:textSize="17sp" android:textStyle="bold" />
                    </LinearLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                        android:text="Profile Type ID: 003" android:textColor="@color/plantdex_text_primary" android:textSize="14sp" />
                    <TextView android:id="@+id/tvTypeName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="Profile Type Name: Researcher" android:textColor="@color/plantdex_text_primary" android:textSize="14sp" />

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="Description:" android:textColor="@color/plantdex_text_primary" android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTypeDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pill"
                        android:padding="12dp"
                        android:text="Verifies plants and architectural records submitted by visitors"
                        android:textColor="@color/plantdex_success_text"
                        android:textSize="13sp" />

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                        android:text="Permissions:" android:textColor="@color/plantdex_text_primary" android:textStyle="bold" android:textSize="14sp" />

                    <CheckBox android:id="@+id/permission1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:text="Verify identification records" android:textColor="@color/plantdex_text_primary" android:checked="true" android:buttonTint="@color/plantdex_bg" />
                    <CheckBox android:id="@+id/permission2" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="View discovery collectibles" android:textColor="@color/plantdex_text_primary" android:checked="true" android:buttonTint="@color/plantdex_bg" />
                    <CheckBox android:id="@+id/permission3" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Manage discovery collectibles" android:textColor="@color/plantdex_text_primary" android:checked="false" android:buttonTint="@color/plantdex_bg" />
                    <CheckBox android:id="@+id/permission4" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Access System Error Logs" android:textColor="@color/plantdex_text_primary" android:checked="false" android:buttonTint="@color/plantdex_bg" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
                        <Button
                            android:id="@+id/btnUpdateType"
                            android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
                            android:background="@drawable/btn_primary" android:backgroundTint="@color/plantdex_chip_bg"
                            android:text="UPDATE" android:textColor="@color/plantdex_chip_text" android:textStyle="bold" android:stateListAnimator="@null" />
                        <Button
                            android:id="@+id/btnCancelType"
                            android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="10dp"
                            android:background="@drawable/btn_secondary"
                            android:text="CANCEL" android:textColor="@color/plantdex_secondary_text" android:textStyle="bold" android:stateListAnimator="@null" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/navContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
