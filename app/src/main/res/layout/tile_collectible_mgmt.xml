<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_tile">
            <ImageView android:id="@+id/collIcon" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_leaf" android:contentDescription="Collectible" />
        </FrameLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/collName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tembusu Tree" android:textColor="@color/plantdex_text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/collSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Collectible #0087" android:textColor="@color/plantdex_text_muted" android:textSize="12sp" />
        </LinearLayout>

        <ImageButton android:id="@+id/btnEditColl" android:layout_width="30dp" android:layout_height="30dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_edit" android:scaleType="centerInside" android:contentDescription="Edit" />
        <ImageButton android:id="@+id/btnDeleteColl" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="4dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_delete" app:tint="@color/plantdex_error_text" android:scaleType="centerInside" android:contentDescription="Delete" xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="@color/plantdex_divider" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Category" android:textColor="@color/plantdex_text_muted" android:textSize="12sp" />
        <TextView android:id="@+id/collCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Flora" android:textColor="@color/plantdex_text_primary" android:textStyle="bold" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Rarity level" android:textColor="@color/plantdex_text_muted" android:textSize="12sp" />
        <TextView android:id="@+id/collRarity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rare" android:textColor="@color/plantdex_text_primary" android:textStyle="bold" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Linked record" android:textColor="@color/plantdex_text_muted" android:textSize="12sp" />
        <TextView android:id="@+id/collLinkedRecord" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="#0231 Tembusu Tree" android:textColor="@color/plantdex_text_primary" android:textStyle="bold" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Status" android:textColor="@color/plantdex_text_muted" android:textSize="12sp" />
        <TextView android:id="@+id/collStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_pill" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="Active" android:textColor="@color/plantdex_success_text" android:textSize="11sp" android:layout_marginEnd="6dp" />
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_chevron_right" android:contentDescription="Open" />
    </LinearLayout>
</LinearLayout>
